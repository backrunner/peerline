{
  "name": "peerline",
  "version": "0.1.0-alpha.2",
  "description": "P2P post-quantum encrypted file transfer CLI",
  "bin": {
    "peerline": "npm/peerline.js"
  },
  "files": [
    "npm/peerline.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "cargo build --release -p peerline-cli",
    "prepack": "node npm/prepack.js",
    "release:alpha": "node npm/release-alpha.js",
    "test": "cargo test --workspace && node --test npm/peerline.test.js npm/release-alpha.test.js",
    "smoke": "node npm/peerline.js --version"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "optionalDependencies": {
    "peerline-darwin-arm64": "0.1.0-alpha.2",
    "peerline-darwin-x64": "0.1.0-alpha.2",
    "peerline-linux-arm64-gnu": "0.1.0-alpha.2",
    "peerline-linux-arm64-musl": "0.1.0-alpha.2",
    "peerline-linux-x64-gnu": "0.1.0-alpha.2",
    "peerline-linux-x64-musl": "0.1.0-alpha.2",
    "peerline-win32-x64-msvc": "0.1.0-alpha.2"
  },
  "license": "Apache-2.0"
}
