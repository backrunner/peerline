{
  "name": "peerline",
  "version": "0.1.0-alpha.3",
  "description": "P2P post-quantum encrypted file transfer CLI",
  "repository": {
    "type": "git",
    "url": "https://github.com/peerline/peerline"
  },
  "bin": {
    "peerline": "npm/peerline.js"
  },
  "files": [
    "npm/peerline.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "cargo build --release -p peerline-cli",
    "lint": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings && node --check npm/peerline.js && node --check npm/release.js && node --check npm/release-alpha.js && node --check npm/peerline.test.js && node --check npm/release.test.js",
    "prepack": "node npm/prepack.js",
    "release:alpha": "node npm/release.js --channel=alpha",
    "release:beta": "node npm/release.js --channel=beta",
    "release:stable": "node npm/release.js --channel=stable",
    "release": "node npm/release.js --channel=stable",
    "test": "cargo test --workspace && node --test npm/peerline.test.js npm/release.test.js",
    "smoke": "node npm/peerline.js --version"
  },
  "publishConfig": {
    "access": "public"
  },
  "optionalDependencies": {
    "peerline-darwin-arm64": "0.1.0-alpha.3",
    "peerline-darwin-x64": "0.1.0-alpha.3",
    "peerline-linux-arm64-gnu": "0.1.0-alpha.3",
    "peerline-linux-arm64-musl": "0.1.0-alpha.3",
    "peerline-linux-x64-gnu": "0.1.0-alpha.3",
    "peerline-linux-x64-musl": "0.1.0-alpha.3",
    "peerline-win32-x64-msvc": "0.1.0-alpha.3"
  },
  "license": "Apache-2.0"
}
